generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model College {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  logo        String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  campuses    Campus[]
  items       Item[]
}

model Campus {
  id          String   @id @default(uuid())
  name        String
  
  collegeId   String
  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  
  buildings   Building[]
  items       Item[]
}

model Building {
  id          String   @id @default(uuid())
  name        String
  type        String?  // Academic Block, Library, etc.
  
  campusId    String
  campus      Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  
  floors      Floor[]
  items       Item[]
}

model Floor {
  id          String   @id @default(uuid())
  name        String
  
  buildingId  String
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  
  areas       Area[]
  items       Item[]
}

model Area {
  id          String   @id @default(uuid())
  name        String
  type        String?  // Classroom, Lab, etc.
  latitude    Float?
  longitude   Float?
  
  floorId     String
  floor       Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  
  items       Item[]
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  rollNumber    String?
  image         String?
  role          String    @default("USER") // USER, ADMIN
  
  collegeId     String?
  college       College?  @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items         Item[]
  claims        Claim[]
  sentMessages  Message[] @relation("SentMessages")
  recvMessages  Message[] @relation("ReceivedMessages")
  notifications Notification[]
}

model Item {
  id            String    @id @default(uuid())
  type          String    // "LOST" or "FOUND"
  status        String    @default("ACTIVE") // ACTIVE, POSSIBLE_MATCH, CLAIM_REQUESTED, VERIFICATION, RECOVERED
  category      String
  title         String
  description   String
  date          DateTime
  time          String?
  
  // Legacy/Fallback location fields
  locationName  String
  locationLat   Float?
  locationLng   Float?
  
  // Structured College Location fields
  collegeId     String?
  college       College?  @relation(fields: [collegeId], references: [id])
  campusId      String?
  campus        Campus?   @relation(fields: [campusId], references: [id])
  buildingId    String?
  building      Building? @relation(fields: [buildingId], references: [id])
  floorId       String?
  floor         Floor?    @relation(fields: [floorId], references: [id])
  areaId        String?
  area          Area?     @relation(fields: [areaId], references: [id])
  
  reward        String?
  contactPref   String?
  distinguishingFeatures String?
  currentPossession String? // For Found items
  idCardImageUrl    String?
  
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  images        ItemImage[]
  claims        Claim[]
  
  matchesAsLost  Match[] @relation("LostItemMatches")
  matchesAsFound Match[] @relation("FoundItemMatches")
}

model ItemImage {
  id      String @id @default(uuid())
  url     String
  itemId  String
  item    Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Match {
  id          String   @id @default(uuid())
  score       Float
  reasons     String   // JSON string or comma separated
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  
  lostItemId  String
  lostItem    Item     @relation("LostItemMatches", fields: [lostItemId], references: [id], onDelete: Cascade)
  
  foundItemId String
  foundItem   Item     @relation("FoundItemMatches", fields: [foundItemId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

model Claim {
  id          String   @id @default(uuid())
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  proofText   String?
  
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  
  claimantId  String
  claimant    User     @relation(fields: [claimantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Message {
  id          String   @id @default(uuid())
  content     String
  
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  
  receiverId  String
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  
  // Optional linkage to a claim or match
  claimId     String?
  
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  type        String   // MATCH, CLAIM, MESSAGE, SYSTEM
  content     String
  link        String?
  isRead      Boolean  @default(false)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}
